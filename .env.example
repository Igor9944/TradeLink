# ─── App ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── Base de Données ──────────────────────────────────────────
# Mot de passe local uniquement: choisissez une valeur unique et alignez-la sur DATABASE_URL.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-unique-local-secret
POSTGRES_DB=tradelink
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:replace-with-a-unique-local-secret@localhost:5432/tradelink"

# Seed accounts (set a unique local password before running Prisma seed)
SEED_USER_PASSWORD=replace-with-a-strong-local-password

# ─── JWT ──────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key
JWT_REFRESH_EXPIRES_IN=7d

# ─── OTP ──────────────────────────────────────────────────────
OTP_SECRET=your-otp-secret-key
OTP_EXPIRES_IN_MINUTES=10

# ─── TOTP/MFA ─────────────────────────────────────────────────
MFA_APP_NAME=TradeLink

# ─── Email (SMTP) ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="TradeLink <noreply@tradelink.com>"

# ─── Upload ──────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# ─── Stripe ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=replace-with-your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-your-stripe-webhook-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=replace-with-your-stripe-publishable-key

# ─── OpenAI ──────────────────────────────────────────────────
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-4o
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# ─── OCR Provider ─────────────────────────────────────────────
OCR_PROVIDER=mock
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=eu-west-1
AWS_S3_BUCKET=tradelink-uploads

# ─── Frontend ─────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── KYC ─────────────────────────────────────────────────────
KYC_DEADLINE_DAYS=7

# ─── Paiements Multi-Gateway (Ajouté Session 3) ───────────────
# CinetPay (Principal Afrique - Mobile Money + Cartes)
CINETPAY_API_KEY=your_cinetpay_api_key
CINETPAY_SITE_ID=your_site_id
CINETPAY_WEBHOOK_SECRET=your_webhook_secret
CINETPAY_NOTIFY_URL=http://localhost:3001/api/webhooks/cinetpay
CINETPAY_RETURN_URL=http://localhost:3000/payment/success

# FedaPay (Complémentaire Togo/Bénin)
FEDAPAY_SECRET_KEY=replace-with-your-fedapay-secret-key
FEDAPAY_PUBLIC_KEY=replace-with-your-fedapay-public-key
FEDAPAY_ENVIRONMENT=sandbox

# ─── Communication (Ajouté Session 3) ──────────────────────────
# Brevo (Email transactionnel)
BREVO_API_KEY=replace-with-your-brevo-api-key

# Africa's Talking (SMS)
AFRICASTALKING_API_KEY=your_africastalking_api_key
AFRICASTALKING_USERNAME=sandbox

# WhatsApp Cloud API
WHATSAPP_PHONE_ID=123456789
WHATSAPP_ACCESS_TOKEN=replace-with-your-whatsapp-access-token
WHATSAPP_WEBHOOK_SECRET=your_webhook_secret

# ─── Infrastructure (Ajouté Session 3) ─────────────────────────
# Redis (BullMQ - File d'attente)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Room Live / LiveKit (développement local) ─────────────────
# Generate distinct random values for each environment. Never reuse these
# placeholders or a development key in production.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=replace-with-a-random-local-key
LIVEKIT_API_SECRET=replace-with-a-random-local-secret
ROOM_INVITE_TTL_DAYS=30

# URLs
API_URL=http://localhost:3001/api
APP_URL=http://localhost:3000
